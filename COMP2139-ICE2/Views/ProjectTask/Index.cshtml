@* specifies the collection of ProjectTasks *@
@model IEnumerable<ProjectTask>  

@{
    ViewData["Title"] = "Tasks List";
}

<h2>@ViewData["Title"]</h2>

<table class="table">
    <thead>
    <tr>
        <th>Task ID</th>
        <th>Title</th>
        <th>Description</th>
        <th>Project ID</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var task in Model)
    {
        <tr>
            <td>@task.ProjectTaskId</td>
            //Missing Title, Description & ProjectId below
            //
            //
            //
            <td>
                <a asp-action="//missing action name" asp-route-id="@task.ProjectTaskId" class="btn btn-info">Details</a>
                <a asp-action="//missing action name" asp-route-id="@task.ProjectTaskId" class="btn btn-secondary">Edit</a>
                <a asp-action="//missing action name" asp-route-id="@task.ProjectTaskId" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<!-- Button to create a new task -->
<a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class=" btn btn-primary">Create New Task</a>

<!-- Button to go back to the list of projects -->
<a asp-controller="Project" asp-action="Index" class="btn btn-secondary">Back to Projects</a>